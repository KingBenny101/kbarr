### REQUIRED — must be set before first run
PROWLARR_API_KEY=        # Your Prowlarr API key: Settings > General > API Key

### REQUIRED — set to your local paths
DATA_DIR_HOST=./data     # Where metadata images and titles dump are stored on the host

### OPTIONAL — defaults are fine for most setups
PORT=8282
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=dev
POSTGRES_DB=appdb
METADATA_SERVICE_PORT=8081
INDEXER_SERVICE_PORT=8082
DOWNLOADER_SERVICE_PORT=8083
QBITTORRENT_URL=http://host.docker.internal:8080

### LOCAL DEV ONLY — not used by Docker
DB_URL=postgres://app:dev@localhost:5432/appdb?sslmode=disable
METADATA_GRPC_ADDR=localhost:8081
INDEXER_GRPC_ADDR=localhost:8082
DOWNLOADER_GRPC_ADDR=localhost:8083
KBARR_DATA_DIR=../../data