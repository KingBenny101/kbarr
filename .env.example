### REQUIRED — must be set before first run
PROWLARR_API_KEY=        # Your Prowlarr API key: Settings > General > API Key

### OPTIONAL — defaults are fine for most setups
PORT=8282
POSTGRES_PORT=5432
POSTGRES_USER=kbarr
POSTGRES_PASSWORD=kbarr
POSTGRES_DB=kbarr
METADATA_SERVICE_PORT=8081
INDEXER_SERVICE_PORT=8082
DOWNLOADER_SERVICE_PORT=8083
QBITTORRENT_URL=http://host.docker.internal:8080
KBARR_DATA_DIR=/app/data
DATA_DIR_HOST=./data

DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT:-5432}/${POSTGRES_DB}?sslmode=disable
