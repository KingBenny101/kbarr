FROM golang:1.25-alpine

WORKDIR /workspace
RUN apk add --no-cache ca-certificates

COPY VERSION ./VERSION
COPY shared ./shared
COPY migrations ./migrations
COPY services/core ./services/core

# Dev mode keeps the embedded placeholder assets; Vite runs separately and core only serves API traffic.

WORKDIR /workspace/services/core
RUN go mod download

EXPOSE 8282
CMD ["go", "run", "./cmd"]
