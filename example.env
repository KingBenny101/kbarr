# Copy this file to .env and adjust the values below.

# === Required ===

# Host path to your media library. kbarr expects two subfolders inside it:
#   <LIBRARY_DIR_HOST>/downloads  — set this as qBittorrent's save path
#   <LIBRARY_DIR_HOST>/media      — kbarr writes organised media here
# Both must live under this single path (same filesystem) so hardlinks work.
LIBRARY_DIR_HOST=./data/library

# === Optional ===

# Host path for kbarr's internal data (metadata cache, images, etc).
DATA_DIR_HOST=./data

# Port kbarr's web UI and API are exposed on.
PORT=8282

# === Internal (no need to change) ===

# These are only used for inter-container communication.
# Postgres is not exposed to the host, so these credentials are not security-critical.
POSTGRES_USER=app
POSTGRES_PASSWORD=dev
POSTGRES_DB=appdb
