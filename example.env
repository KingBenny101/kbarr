### REQUIRED
DATA_DIR_HOST=./data          # Host path for images and AniDB title cache
POSTGRES_USER=app
POSTGRES_PASSWORD=dev
POSTGRES_DB=appdb

### OPTIONAL — defaults shown
PORT=8282                     # Host port core is exposed on
QBITTORRENT_URL=http://host.docker.internal:8080

### LOCAL DEV ONLY — for running services directly outside Docker
DB_URL=postgres://app:dev@localhost:5432/appdb?sslmode=disable
METADATA_ADDR=http://localhost:8081
INDEXER_HEALTH_ADDR=http://localhost:8082
DOWNLOADER_HEALTH_ADDR=http://localhost:8083
KBARR_DATA_DIR=../../data
