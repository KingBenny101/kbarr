# Host folder for kbarr's internal data (caches, metadata, images).
DATA_DIR_HOST=./data
# Host folder for the shared media library, mounted at /library in the containers.
# kbarr expects two subfolders inside it:
#   <LIBRARY_DIR_HOST>/downloads  -> qBittorrent must save torrents here (maps to /library/downloads)
#   <LIBRARY_DIR_HOST>/media      -> kbarr writes organised hardlinks here (maps to /library/media)
# Both must be under this one mount so they share a filesystem and hardlinks work.
LIBRARY_DIR_HOST=./data/library
POSTGRES_USER=app
POSTGRES_PASSWORD=dev
POSTGRES_DB=appdb
PORT=8282
